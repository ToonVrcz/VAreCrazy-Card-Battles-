{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/",
      "destination": "/public/admin.html"
    },
    {
      "source": "/card-renderer.js",
      "destination": "/public/card-renderer.js"
    },
    {
      "source": "/play",
      "destination": "/public/play.html"
    },
    {
      "source": "/admin-tools.js",
      "destination": "/public/admin-tools.js"
    },
    {
      "source": "/admin-bulk.js",
      "destination": "/public/admin-bulk.js"
    },
    {
      "source": "/engine.js",
      "destination": "/public/engine.js"
    },
    {
      "source": "/api/:path*",
      "destination": "https://jcjqooeckoapoikcwpet.supabase.co/functions/v1/api/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://jcjqooeckoapoikcwpet.supabase.co/storage/v1/object/public/card-media/media/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
